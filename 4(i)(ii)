library(ggplot2)

# Identify highest salary
highest_salary <- max(employee$Salary)

# Create a new column
employee$Status <- ifelse(
  employee$Salary == highest_salary,
  "Highest Paid",
  "Employee"
)

# Visualization
ggplot(employee, aes(x = Name, y = Salary, fill = Status)) +
  geom_bar(stat = "identity") +
  labs(
    title = "Highest Paid Employee Analysis",
    x = "Employee",
    y = "Salary"
  ) +
  theme_minimal()
